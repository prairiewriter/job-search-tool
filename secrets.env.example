# ==============================================================================
# secrets.env - your private credentials. Copy this file to "secrets.env"
# (remove ".example") in the SAME FOLDER as job_search.py. Never share this
# file, paste it into chat, or commit it to any git repository.
# ==============================================================================

# --- Adzuna (required for the main job search) --------------------------------
# Free account: https://developer.adzuna.com/signup
# After signing up, create an "Application" in their dashboard to get these two.
# Free tier allows 250 calls/day; this script uses roughly 20-60 per run.
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# --- Email (required to receive the daily digest) ------------------------------
# Gmail example: you need an "App Password", NOT your normal Gmail password.
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Create an app password: https://myaccount.google.com/apppasswords
#   3. Paste that 16-character code below (spaces are fine, or remove them).
# Using Outlook, Yahoo, or another provider? They have an equivalent "app
# password" setting - search "<provider name> app password smtp".
JOBSEARCH_SMTP_USER=your_email@gmail.com
JOBSEARCH_SMTP_PASSWORD=your 16 character app password
JOBSEARCH_EMAIL_TO=your_email@gmail.com

# Only needed if you're NOT using Gmail. Delete these two lines for Gmail.
# JOBSEARCH_SMTP_SERVER=smtp.office365.com
# JOBSEARCH_SMTP_PORT=587
